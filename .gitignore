# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling caches
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# Docs
docs/_build/

# Agent
.claude/settings.local.json

# Data: private data never leaves this machine, but its manifest does.
# The dataset root is the checkout itself, so the embargoed records sit inside the
# repository and these rules are what keep them out of it. MANIFEST.toml is the deliberate
# exception: it inventories the records by sha256 so a result can be audited by someone who
# will never receive them.
data/real_private/*
!data/real_private/MANIFEST.toml

# Data: simulated payloads are regenerated, their manifests are not
data/simulated/*
!data/simulated/*.toml
!data/simulated/*.json

# Outputs: artifacts are too large to track; run manifests are committed by hand.
# `output/` is the one directory the tool writes, and it runs to hundreds of megabytes. The
# two backup names are listed pre-emptively, so that restoring either from elsewhere cannot
# un-ignore it by accident.
output/
output_backup/
output_backup2/

# Tool caches. `quebra.core.closure` passes `cache_dir=None` so grimp never writes this,
# but grimp is a runtime dependency and a default-argument call would recreate it - and
# the cache is keyed on MTIME, so a stale one produces a wrong import graph and an identity
# that silently stops covering a module.
.grimp_cache/
# `make arch` passes --no-cache for the same mtime reason, but a bare `lint-imports` writes
# this. The directory carries its own nested `.gitignore`, which is already enough to keep
# git from tracking it - hatchling, however, honours only the ROOT ignore file, so without
# this rule the cache ships inside the sdist.
.import_linter_cache/

# OS
.DS_Store

# Planted by tests/test_marker_discipline.py's child-pytest probes. They are removed in a
# `finally`, but a hard kill would otherwise leave a foreign conftest holding a deselector
# where `git add -A` would sweep it into the tree.
tests/_race_tmp/
tests/test_zz_probe_tmp.py
tests/test_zz_record_probe_tmp.py

# Copyrighted source PDFs for the gold-standard check; never tracked.
spec/sources/
