    given-names: "Sera"
    email: "sera.conti@usp.br"
license: GPL-3.0-or-later
repository-code: "https://github.com/seraconti/quebra"
url: "https://github.com/seraconti/quebra"
keywords:
  - qubit
  - reliability
  - survival analysis
  - repairable systems
  - quantum characterisation
  - reproducibility
version: "0.1.0"
date-released: "2026-10-02"
